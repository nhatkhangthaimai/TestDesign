datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------
// 1. IDENTITY & ACCESS MANAGEMENT (TiDB / MySQL)
// ---------------------------------------------------------

model User {
  id            String            @id @default(uuid()) @db.VarChar(36)
  email         String            @unique @db.VarChar(191)
  passwordHash  String            @db.VarChar(255)
  name          String            @db.VarChar(191)
  phone         String?           @db.VarChar(50)
  role          String            @default("ROLE_USER") @db.VarChar(50)
  avatar        String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  addresses     ShippingAddress[]
  orders        Order[]
  reviews       Review[]
  wishlists     Wishlist[]
  cart          Cart?
  couponUsages  CouponUsage[]
  viewEvents    ProductViewEvent[]
  searchEvents  SearchEvent[]
  cartEvents    CartEvent[]

  @@map("users")
}

model ShippingAddress {
  id            String   @id @default(uuid()) @db.VarChar(36)
  userId        String   @db.VarChar(36)
  recipientName String   @db.VarChar(191)
  phone         String   @db.VarChar(50)
  street        String   @db.VarChar(255)
  ward          String   @db.VarChar(100)
  district      String   @db.VarChar(100)
  city          String   @db.VarChar(100)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("shipping_addresses")
}

// ---------------------------------------------------------
// 2. PRODUCT CATALOG & TAXONOMY (TiDB / MySQL)
// ---------------------------------------------------------

model Category {
  id          String     @id @default(uuid()) @db.VarChar(36)
  name        String     @db.VarChar(191)
  slug        String     @unique @db.VarChar(191)
  description String?    @db.Text
  imageUrl    String?    @db.Text
  parentId    String?    @db.VarChar(36)
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryToCategory")
  products    Product[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid()) @db.VarChar(36)
  name        String    @db.VarChar(191)
  slug        String    @unique @db.VarChar(191)
  logoUrl     String?   @db.Text
  description String?   @db.Text
  website     String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("brands")
}

model Product {
  id                    String                 @id @default(uuid()) @db.VarChar(36)
  title                 String                 @db.VarChar(255)
  slug                  String                 @unique @db.VarChar(191)
  description           String                 @db.Text
  content               String?                @db.MediumText
  regularPrice          Decimal                @db.Decimal(14, 2)
  salePrice             Decimal?               @db.Decimal(14, 2)
  sku                   String                 @unique @db.VarChar(100)
  stock                 Int                    @default(0)
  isFeatured            Boolean                @default(false)
  isNewArrival          Boolean                @default(false)
  isBestSeller          Boolean                @default(false)
  isFlashSale           Boolean                @default(false)
  flashSaleStart        DateTime?
  flashSaleEnd          DateTime?
  categoryId            String                 @db.VarChar(36)
  brandId               String?                @db.VarChar(36)
  ratingsAvg            Decimal                @default(0.0) @db.Decimal(3, 2)
  ratingsCount          Int                    @default(0)
  status                String                 @default("ACTIVE") @db.VarChar(50)
  warrantyMonths        Int                    @default(12)
  originCountry         String?                @default("Chính Hãng") @db.VarChar(100)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand                 Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images                ProductImage[]
  variants              ProductVariant[]
  reviews               Review[]
  wishlists             Wishlist[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  specifications        ProductSpecification[]
  compatibilities       ProductCompatibility[] @relation("ProductToCompat")
  compatibleTargets     ProductCompatibility[] @relation("CompatTarget")
  priceHistories        ProductPriceHistory[]
  inventories           Inventory[]
  inventoryTransactions InventoryTransaction[]
  viewEvents            ProductViewEvent[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([regularPrice])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.VarChar(36)
  productId String   @db.VarChar(36)
  url       String   @db.Text
  altText   String?  @db.VarChar(255)
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id                    String                 @id @default(uuid()) @db.VarChar(36)
  productId             String                 @db.VarChar(36)
  name                  String                 @db.VarChar(191)
  sku                   String                 @unique @db.VarChar(100)
  price                 Decimal                @db.Decimal(14, 2)
  stock                 Int                    @default(0)
  attributesJson        String?                @db.Text
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems             CartItem[]
  orderItems            OrderItem[]
  inventories           Inventory[]
  inventoryTransactions InventoryTransaction[]

  @@index([productId])
  @@map("product_variants")
}

model ProductSpecification {
  id        String   @id @default(uuid()) @db.VarChar(36)
  productId String   @db.VarChar(36)
  groupName String   @db.VarChar(100)
  specKey   String   @db.VarChar(100)
  specValue String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([specKey])
  @@map("product_specifications")
}

model ProductAttribute {
  id          String                  @id @default(uuid()) @db.VarChar(36)
  name        String                  @db.VarChar(100)
  code        String                  @unique @db.VarChar(50)
  description String?                 @db.Text
  values      ProductAttributeValue[]

  @@map("product_attributes")
}

model ProductAttributeValue {
  id          String           @id @default(uuid()) @db.VarChar(36)
  attributeId String           @db.VarChar(36)
  value       String           @db.VarChar(100)
  code        String           @db.VarChar(50)
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@index([attributeId])
  @@map("product_attribute_values")
}

model ProductCompatibility {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  productId           String   @db.VarChar(36)
  compatibleProductId String   @db.VarChar(36)
  compatibilityType   String   @default("ACCESSORY") @db.VarChar(50)
  notes               String?  @db.Text
  createdAt           DateTime @default(now())
  product             Product  @relation("ProductToCompat", fields: [productId], references: [id], onDelete: Cascade)
  compatibleProduct   Product  @relation("CompatTarget", fields: [compatibleProductId], references: [id], onDelete: Cascade)

  @@unique([productId, compatibleProductId])
  @@index([productId])
  @@map("product_compatibilities")
}

model ProductPriceHistory {
  id           String   @id @default(uuid()) @db.VarChar(36)
  productId    String   @db.VarChar(36)
  oldPrice     Decimal  @db.Decimal(14, 2)
  newPrice     Decimal  @db.Decimal(14, 2)
  changeReason String?  @db.VarChar(255)
  changedBy    String?  @default("Hệ thống tự động") @db.VarChar(100)
  effectiveAt  DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, effectiveAt])
  @@map("product_price_histories")
}

// ---------------------------------------------------------
// 3. INVENTORY & WAREHOUSE (TiDB / MySQL)
// ---------------------------------------------------------

model Inventory {
  id            String          @id @default(uuid()) @db.VarChar(36)
  productId     String          @db.VarChar(36)
  variantId     String?         @db.VarChar(36)
  warehouseCode String          @default("WH-HCM-01") @db.VarChar(50)
  quantity      Int             @default(0)
  reservedQty   Int             @default(0)
  safetyStock   Int             @default(10)
  lastCountAt   DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([warehouseCode])
  @@map("inventories")
}

model InventoryTransaction {
  id              String          @id @default(uuid()) @db.VarChar(36)
  productId       String          @db.VarChar(36)
  variantId       String?         @db.VarChar(36)
  warehouseCode   String          @default("WH-HCM-01") @db.VarChar(50)
  transactionType String          @db.VarChar(50)
  quantity        Int
  referenceNumber String?         @db.VarChar(100)
  note            String?         @db.Text
  createdAt       DateTime        @default(now())
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([transactionType])
  @@map("inventory_transactions")
}

// ---------------------------------------------------------
// 4. SHOPPING CART & ORDERS (TiDB / MySQL)
// ---------------------------------------------------------

model Cart {
  id        String     @id @default(uuid()) @db.VarChar(36)
  userId    String?    @unique @db.VarChar(36)
  sessionId String?    @unique @db.VarChar(100)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String          @id @default(uuid()) @db.VarChar(36)
  cartId    String          @db.VarChar(36)
  productId String          @db.VarChar(36)
  variantId String?         @db.VarChar(36)
  quantity  Int             @default(1)
  price     Decimal         @db.Decimal(14, 2)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id               String               @id @default(uuid()) @db.VarChar(36)
  orderNumber      String               @unique @db.VarChar(50)
  userId           String?              @db.VarChar(36)
  customerName     String               @db.VarChar(191)
  customerEmail    String               @db.VarChar(191)
  customerPhone    String               @db.VarChar(50)
  shippingAddress  String               @db.VarChar(255)
  shippingCity     String               @db.VarChar(100)
  shippingDistrict String               @db.VarChar(100)
  shippingWard     String               @db.VarChar(100)
  note             String?              @db.Text
  subtotal         Decimal              @db.Decimal(14, 2)
  discount         Decimal              @default(0.00) @db.Decimal(14, 2)
  shippingFee      Decimal              @default(0.00) @db.Decimal(14, 2)
  total            Decimal              @db.Decimal(14, 2)
  status           String               @default("PENDING") @db.VarChar(50)
  paymentMethod    String               @default("COD") @db.VarChar(50)
  paymentStatus    String               @default("PENDING") @db.VarChar(50)
  couponCode       String?              @db.VarChar(50)
  transactionId    String?              @db.VarChar(100)
  isSimulated      Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  payment          Payment?
  couponUsages     CouponUsage[]

  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id           String          @id @default(uuid()) @db.VarChar(36)
  orderId      String          @db.VarChar(36)
  productId    String          @db.VarChar(36)
  variantId    String?         @db.VarChar(36)
  productTitle String          @db.VarChar(255)
  sku          String          @db.VarChar(100)
  price        Decimal         @db.Decimal(14, 2)
  quantity     Int
  total        Decimal         @db.Decimal(14, 2)
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String   @id @default(uuid()) @db.VarChar(36)
  orderId   String   @db.VarChar(36)
  status    String   @db.VarChar(50)
  note      String?  @db.Text
  changedBy String?  @default("Hệ thống") @db.VarChar(100)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model Payment {
  id              String    @id @default(uuid()) @db.VarChar(36)
  orderId         String    @unique @db.VarChar(36)
  amount          Decimal   @db.Decimal(14, 2)
  provider        String    @db.VarChar(50)
  status          String    @default("PENDING") @db.VarChar(50)
  transactionRef  String?   @db.VarChar(100)
  rawResponseJson String?   @db.Text
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Coupon {
  id            String        @id @default(uuid()) @db.VarChar(36)
  code          String        @unique @db.VarChar(50)
  description   String        @db.VarChar(255)
  discountType  String        @default("PERCENTAGE") @db.VarChar(50)
  discountValue Decimal       @db.Decimal(14, 2)
  minOrderValue Decimal       @default(0.00) @db.Decimal(14, 2)
  maxDiscount   Decimal?      @db.Decimal(14, 2)
  usageLimit    Int           @default(100)
  usageCount    Int           @default(0)
  expiresAt     DateTime?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  usages        CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id              String   @id @default(uuid()) @db.VarChar(36)
  couponId        String   @db.VarChar(36)
  userId          String?  @db.VarChar(36)
  orderId         String   @db.VarChar(36)
  discountApplied Decimal  @db.Decimal(14, 2)
  usedAt          DateTime @default(now())
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([orderId])
  @@map("coupon_usages")
}

model Review {
  id                 String   @id @default(uuid()) @db.VarChar(36)
  productId          String   @db.VarChar(36)
  userId             String   @db.VarChar(36)
  rating             Int      @default(5)
  title              String?  @db.VarChar(255)
  comment            String   @db.Text
  isVerifiedPurchase Boolean  @default(true)
  isSimulated        Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("reviews")
}

model Wishlist {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  productId String   @db.VarChar(36)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlists")
}

model Banner {
  id        String   @id @default(uuid()) @db.VarChar(36)
  title     String   @db.VarChar(255)
  subtitle  String?  @db.VarChar(255)
  imageUrl  String   @db.Text
  linkUrl   String?  @default("/products") @db.VarChar(255)
  badgeText String?  @db.VarChar(100)
  position  String   @default("HERO") @db.VarChar(50)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model StoreSetting {
  id          String   @id @default(uuid()) @db.VarChar(36)
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt

  @@map("store_settings")
}

// ---------------------------------------------------------
// 5. BIG DATA TELEMETRY, ANALYTICS & AUDIT LOGS (TiDB / MySQL)
// ---------------------------------------------------------

model ProductViewEvent {
  id                 String   @id @default(uuid()) @db.VarChar(36)
  sessionId          String   @db.VarChar(100)
  userId             String?  @db.VarChar(36)
  productId          String   @db.VarChar(36)
  referrer           String?  @db.Text
  userAgent          String?  @db.Text
  ipAddress          String?  @db.VarChar(50)
  dwellTimeSeconds   Int      @default(0)
  viewportResolution String?  @db.VarChar(50)
  createdAt          DateTime @default(now())
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
  @@map("product_view_events")
}

model SearchEvent {
  id               String   @id @default(uuid()) @db.VarChar(36)
  sessionId        String?  @db.VarChar(100)
  userId           String?  @db.VarChar(36)
  query            String   @db.VarChar(255)
  normalizedQuery  String?  @db.VarChar(255)
  filtersJson      String?  @db.Text
  resultCount      Int      @default(0)
  executionMs      Float    @default(0)
  clickedProductId String?  @db.VarChar(36)
  createdAt        DateTime @default(now())
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([query])
  @@index([createdAt])
  @@map("search_events")
}

model CartEvent {
  id        String   @id @default(uuid()) @db.VarChar(36)
  sessionId String   @db.VarChar(100)
  userId    String?  @db.VarChar(36)
  productId String   @db.VarChar(36)
  variantId String?  @db.VarChar(36)
  action    String   @db.VarChar(50)
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
  @@map("cart_events")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  actorId     String?  @db.VarChar(36)
  actorRole   String?  @default("SYSTEM") @db.VarChar(50)
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String?  @db.VarChar(36)
  ipAddress   String?  @db.VarChar(50)
  userAgent   String?  @db.Text
  changesJson String?  @db.MediumText
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------
// 6. BENCHMARKING & SCALE VERIFICATION (TiDB / MySQL)
// ---------------------------------------------------------

model BenchmarkSession {
  id               String                 @id @default(uuid()) @db.VarChar(36)
  sessionCode      String                 @unique @db.VarChar(100)
  targetSizeBytes  BigInt                 @default(0)
  currentSizeBytes BigInt                 @default(0)
  status           String                 @default("IN_PROGRESS") @db.VarChar(50)
  totalRecords     Int                    @default(0)
  errorCount       Int                    @default(0)
  notes            String?                @db.Text
  startedAt        DateTime               @default(now())
  completedAt      DateTime?
  transactions     BenchmarkTransaction[]

  @@map("benchmark_sessions")
}

model BenchmarkTransaction {
  id              String           @id @default(uuid()) @db.VarChar(36)
  sessionId       String           @db.VarChar(36)
  batchNumber     Int
  recordType      String           @db.VarChar(50)
  recordCount     Int
  executionTimeMs Float
  bytesAdded      BigInt           @default(0)
  status          String           @default("SUCCESS") @db.VarChar(50)
  createdAt       DateTime         @default(now())
  session         BenchmarkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, batchNumber])
  @@index([createdAt])
  @@map("benchmark_transactions")
}

model DataImportJob {
  id               String    @id @default(uuid()) @db.VarChar(36)
  jobName          String    @db.VarChar(100)
  stage            String    @db.VarChar(50)
  targetSize       String    @db.VarChar(50)
  status           String    @default("PENDING") @db.VarChar(50)
  recordsProcessed Int       @default(0)
  currentBytes     BigInt    @default(0)
  errorMessage     String?   @db.Text
  startedAt        DateTime?
  finishedAt       DateTime?

  @@map("data_import_jobs")
}

